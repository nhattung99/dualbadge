{
  "name": "dualbadge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm run gen:chain",
    "gen:chain": "node scripts/gen-chain.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && hardhat test --no-compile",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "deploy:metamask": "node --experimental-strip-types scripts/deploy-metamask.ts"
  },
  "dependencies": {
    "@rome-protocol/registry": "git+https://github.com/rome-protocol/rome-registry.git#db0bf1f331c9b81be62d09f180965a64746b5991",
    "@rome-protocol/sdk": "git+https://github.com/rome-protocol/rome-sdk-ts.git#v0.4.0",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.14",
    "@wallet-standard/app": "1.1.0",
    "next": "15.5.29",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "viem": "2.38.5",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@eslint/eslintrc": "3.3.1",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.29",
    "hardhat": "2.26.3",
    "solc": "0.8.28",
    "tailwindcss": "3.4.18",
    "postcss": "8.5.10",
    "typescript": "5.9.3"
  }
}
